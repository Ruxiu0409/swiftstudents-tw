---
import Layout from '../../layouts/Layout.astro';
import EventList from '../EventList.astro';
import EventInfo from '../EventInfo.astro';
import EventProse from '../EventProse.astro';
import { getEventsByLang } from '../../lib/events';
import { splitEvents, hasAnyTag, CAMP_TAGS } from '../../lib/event-utils';
import { useTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const camps = hasAnyTag(await getEventsByLang(lang), CAMP_TAGS);
const { upcoming, past } = splitEvents(camps);
---
<Layout lang={lang} title={t('meta.camps_title')} description={t('meta.camps_desc')}>
  <section class="section">
    <div class="container">
      <h1>{t('nav.camps')}</h1>
      <p class="muted">{t('camps.intro')}</p>

      {upcoming.length === 0 && <p class="empty muted">{t('camps.empty')}</p>}

      {upcoming.map((entry) => (
        <article class="camp" aria-labelledby={`camp-${entry.id}`}>
          <p class="camp__eyebrow">{t('camps.upcoming')}</p>
          <h2 id={`camp-${entry.id}`} class="camp__title">{entry.data.title}</h2>
          <p class="camp__summary">{entry.data.summary}</p>
          <EventInfo entry={entry} lang={lang} />
          {entry.data.registerUrl && (
            <a class="btn btn--primary camp__cta" href={entry.data.registerUrl}>{t('detail.register')}</a>
          )}
          <EventProse entry={entry} />
        </article>
      ))}

      {past.length > 0 && (
        <section id="past" class="group" aria-labelledby="past-heading">
          <h2 id="past-heading">{t('camps.past')}</h2>
          <div class="list">
            <EventList events={past} lang={lang} emptyKey="camps.empty" />
          </div>
        </section>
      )}
    </div>
  </section>
</Layout>
<style>
  .empty { padding-block: var(--space-4); }
  .camp { max-width: 720px; margin-top: var(--space-8); }
  .camp__eyebrow { color: var(--color-accent); font-size: var(--fs-small); font-weight: 600; }
  .camp__title { margin-top: 0.5rem; }
  .camp__summary { margin-top: var(--space-2); }
  .camp__cta { margin-top: var(--space-3); }
  .group { margin-top: var(--space-8); scroll-margin-top: 80px; }
  .list { margin-top: var(--space-4); }
</style>
