---
/**
 * Hand-drawn hero for the Asia Student App Challenge camp, built from the
 * artwork on appchallenge.asia/tw (Taipei 101 + globe + logo, rocket below).
 */
interface Props {
  title: string;
  summary: string;
  dates: string;
  location: string;
  registerUrl?: string;
  registerLabel: string;
  logoAlt: string;
}
const { title, summary, dates, location, registerUrl, registerLabel, logoAlt } = Astro.props;
const art = '/camps/asac';
---
<div class="hero">
  <div class="hero__art">
    <img class="hero__accessory" src={`${art}/tw.taipei101.webp`} alt="" aria-hidden="true" width="512" height="512" />
    <img class="hero__globe" src={`${art}/tw.globe.webp`} alt="" aria-hidden="true" width="512" height="512" />
    <img class="hero__logo" src={`${art}/tw.logo.svg`} alt={logoAlt} width="556" height="460" />
  </div>
  <h1 class="hero__title">{title}</h1>
  <p class="hero__summary">{summary}</p>
  {registerUrl && <a class="btn btn--register hero__cta" href={registerUrl}>{registerLabel}</a>}
  <p class="hero__meta">{dates} • {location}</p>
  <img class="hero__rocket" src={`${art}/ww.hero.rocket.webp`} alt="" aria-hidden="true" width="1920" height="1080" loading="lazy" />
</div>
<style>
  .hero { text-align: center; max-width: 560px; margin-inline: auto; }
  /* Same composition as appchallenge.asia: logo on top, globe behind it, Taipei 101 leaning in from the left. */
  .hero__art { position: relative; width: 80%; aspect-ratio: 556 / 460; margin-inline: auto; }
  .hero__logo { position: absolute; z-index: 3; inset: 0 auto auto 0; width: 100%; height: auto; }
  .hero__globe { position: absolute; z-index: 1; width: 50%; right: 0; top: 4%; transform: rotate(-8deg); }
  .hero__accessory { position: absolute; z-index: 2; width: 30%; left: -20%; bottom: 5%; transform: rotate(-15deg); }
  /* On phones the container is narrow; pull Taipei 101 in so it isn't cut off at the screen edge. */
  @media (max-width: 480px) { .hero__accessory { left: -12%; } }
  .hero__title {
    margin-top: var(--space-3);
    font-size: clamp(1.75rem, 6vw, 2.5rem); font-weight: 700; letter-spacing: -0.02em;
  }
  .hero__summary { margin-top: var(--space-2); color: var(--color-text-muted); }
  .hero__cta { margin-top: var(--space-3); }
  .hero__meta { margin-top: 0.5rem; font-size: var(--fs-small); font-weight: 600; }
  .hero__rocket { width: 100%; height: auto; margin-top: var(--space-2); }
</style>
