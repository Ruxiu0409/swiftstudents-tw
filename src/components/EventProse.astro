---
import { render } from 'astro:content';
import type { EventEntry } from '../lib/events';

interface Props { entry: EventEntry; }
const { Content } = await render(Astro.props.entry);
---
<div class="prose">
  <Content />
</div>
<style>
  .prose { margin-top: var(--space-4); }
  .prose :global(p) { margin-block: var(--space-2); }
  .prose :global(h2) { font-size: var(--fs-h3); margin-top: var(--space-4); }
  /* Hand-drawn icon placed at the start of a heading, e.g. ## ![](/camps/asac/ww.kickoff.webp) Day 1 */
  .prose :global(h2 img) {
    display: inline-block; width: 2.25em; height: 2.25em; object-fit: contain;
    vertical-align: middle; margin: -0.25em 0.25em -0.25em -0.25em;
  }
  .prose :global(h3) { margin-top: var(--space-3); }
  .prose :global(ul) { margin-block: var(--space-2); padding-left: 1.25rem; }
  .prose :global(li + li) { margin-top: 0.25rem; }
  .prose :global(table) {
    width: 100%; margin-block: var(--space-2); border-collapse: collapse;
    font-size: var(--fs-small);
  }
  .prose :global(th), .prose :global(td) {
    text-align: left; vertical-align: top;
    padding: 0.6rem 0.75rem; border-bottom: 1px solid var(--color-border);
  }
  .prose :global(th) { font-weight: 600; }
  .prose :global(td:first-child) { white-space: nowrap; font-variant-numeric: tabular-nums; color: var(--color-text-muted); }
</style>
